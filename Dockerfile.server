# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM rust:1.98.0-trixie@sha256:620dbcd124499c59e2406d3741574b5c5838cf9eb9656f0c3a03948f79b02959 AS builder

# The official image has not published 1.98.1 yet. Install the stable patch
# explicitly so the container uses the same compiler as the workspace and CI.
RUN rustup toolchain install 1.98.1 --profile minimal && rustup default 1.98.1

WORKDIR /src
COPY . .

RUN cargo build --release --locked -p sorotte-server --bin sorotte-server

FROM debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG SOURCE_REPOSITORY="https://github.com/ropbet-radbyt/sorotte"

LABEL org.opencontainers.image.title="sorotte server" \
      org.opencontainers.image.description="Sorotte Syncplay-compatible server" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

RUN set -eux; \
    groupadd --system --gid 10001 sorotte; \
    useradd --system --uid 10001 --gid sorotte --home-dir /data --shell /usr/sbin/nologin sorotte; \
    mkdir -p /data /tls; \
    chown -R sorotte:sorotte /data /tls

COPY --from=builder /src/target/release/sorotte-server /usr/local/bin/sorotte-server

USER sorotte
WORKDIR /data

EXPOSE 8999/tcp
VOLUME ["/data", "/tls"]

ENTRYPOINT ["sorotte-server"]
CMD ["--port", "8999", "--ipv4-only", "--interface-ipv4", "0.0.0.0"]
