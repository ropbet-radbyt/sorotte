# syntax=docker/dockerfile:1

FROM rust:1.95-bookworm AS builder

WORKDIR /src
COPY . .

RUN cargo build --release -p syncplay-server --bin syncplay-server

FROM debian:bookworm-slim AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG SOURCE_REPOSITORY="https://github.com/ropbet-radbyt/syncplay-rs"

LABEL org.opencontainers.image.title="syncplay-rs server" \
      org.opencontainers.image.description="Rust Syncplay-compatible server" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

RUN set -eux; \
    groupadd --system --gid 10001 syncplay; \
    useradd --system --uid 10001 --gid syncplay --home-dir /data --shell /usr/sbin/nologin syncplay; \
    mkdir -p /data /tls; \
    chown -R syncplay:syncplay /data /tls

COPY --from=builder /src/target/release/syncplay-server /usr/local/bin/syncplay-server

USER syncplay
WORKDIR /data

EXPOSE 8999/tcp
VOLUME ["/data", "/tls"]

ENTRYPOINT ["syncplay-server"]
CMD ["--port", "8999", "--ipv4-only", "--interface-ipv4", "0.0.0.0"]
