# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

FROM rust:1.100.0-trixie@sha256:223cc32ddca8f3ee90c436dbc94b6b5f052ea7f9653c5201e9612f08ad7d21b8 AS builder

# The base image and its digest are reviewed separately. Install the compiler
# selected by verification-tools.toml, matching the workspace and CI.
RUN rustup toolchain install 1.100.0 --profile minimal && rustup default 1.100.0

WORKDIR /src
COPY . .

RUN cargo build --release --locked -p sorotte-server --bin sorotte-server

FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG SOURCE_REPOSITORY="https://github.com/ropbet-radbyt/sorotte"

LABEL org.opencontainers.image.title="sorotte server" \
      org.opencontainers.image.description="Sorotte Syncplay-compatible server" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

RUN set -eux; \
    groupadd --system --gid 10001 sorotte; \
    useradd --system --uid 10001 --gid sorotte --home-dir /data --shell /usr/sbin/nologin sorotte; \
    mkdir -p /data /tls; \
    chown -R sorotte:sorotte /data /tls

COPY --from=builder /src/target/release/sorotte-server /usr/local/bin/sorotte-server

USER sorotte
WORKDIR /data

EXPOSE 8999/tcp
VOLUME ["/data", "/tls"]

ENTRYPOINT ["sorotte-server"]
CMD ["--port", "8999", "--ipv4-only", "--interface-ipv4", "0.0.0.0"]
