          "expectedClass": "SharedIntroOutroOnly",
          "minimumTier": "Reject",
          "autoplayEligible": false,
          "mustBeRetrieved": false
        }
      ]
    },
    {
      "name": "dub-same-video-different-audio",
      "query": "audio/japanese-audio.mkv",
      "candidates": [
        {
          "path": "audio/english-dub-same-video.mkv",
