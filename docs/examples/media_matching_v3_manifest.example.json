        {
          "path": "collisions/same-soundtrack-b.mkv",
          "expectedClass": "SameAudioDifferentVideo",
          "minimumTier": "Probable",
          "autoplayEligible": false,
          "mustBeRetrieved": true
        }
      ]
    },
    {
      "name": "crop-letterbox",
      "query": "video/full-frame.mkv",
      "candidates": [
        {
          "path": "video/cropped-or-letterboxed.mkv",
