{
  "profile": "combined-v3",
  "baseDir": "replace-with-your-media-root",
  "cases": [
    {
      "name": "remux-same-source",
      "query": "remux/source-a.mkv",
      "candidates": [
        {
          "path": "remux/source-a-remux.mkv",
          "expectedClass": "SameCutStrong",
          "minimumTier": "Strong",
          "expectedOffsetMs": 0,
          "maxOffsetErrorMs": 1000,
          "autoplayEligible": true,
          "mustBeRetrieved": true
        }
      ]
    },
    {
      "name": "different-encode",
      "query": "encodes/episode-x264.mkv",
      "candidates": [
        {
          "path": "encodes/episode-x265-or-av1.mkv",
          "expectedClass": "SameCutStrong",
          "minimumTier": "Strong",
          "expectedOffsetMs": 0,
          "maxOffsetErrorMs": 1000,
          "autoplayEligible": true,
          "mustBeRetrieved": true
        }
      ]
    },
    {
      "name": "offset-tv-vs-bd",
      "query": "offsets/tv-version.mkv",
      "candidates": [
        {
          "path": "offsets/bd-version.mkv",
          "expectedClass": "SameCutStrong",
          "minimumTier": "Strong",
          "expectedOffsetMs": 5000,
          "maxOffsetErrorMs": 1000,
          "autoplayEligible": true,
          "mustBeRetrieved": true
        }
      ]
    },
    {
      "name": "different-cut-inserted-logo",
